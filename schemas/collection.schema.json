{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/v2/collection.schema.json",
  "title": "Collection record (R1.5 \u2014 reserved)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "items"
  ],
  "properties": {
    "schema_version": {},
    "is_illustrative": {},
    "redirect_from": {},
    "sources": {},
    "editorial": {},
    "disclosure": {},
    "id": {
      "type": "string",
      "pattern": "^col_[a-z0-9_]+$",
      "maxLength": 64
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(tool|task|res|pb|cmp)_[a-z0-9_]+$"
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "minItems": 2,
      "uniqueItems": false,
      "maxItems": 30
    }
  }
}