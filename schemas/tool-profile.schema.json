{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-profile.schema.json",
  "title": "Tool profile (D-084)",
  "description": "One short paragraph, a pricing model, a free-tier flag and a price note for every registry tool. Shown with a Preview label until verified.",
  "type": "object",
  "required": ["slug", "description", "pricing_model", "free_tier", "price_note", "verification", "preview"],
  "additionalProperties": false,
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 30, "maxLength": 600},
    "pricing_model": {"enum": ["free","freemium","free_trial","paid_subscription","paid_once","open_source","usage_based","enterprise_quote","mixed","unknown"]},
    "free_tier": {"enum": ["yes","no","limited","unknown"]},
    "price_note": {"type": "string", "minLength": 1, "maxLength": 200},
    "verification": {
      "type": "object",
      "required": ["level","checked","source","checked_on"],
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["ai_draft","web_seen"]},
        "checked": {"type": ["string","null"]},
        "source": {"type": ["string","null"], "format": "uri"},
        "checked_on": {"type": ["string","null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "preview": {
      "type": "object",
      "required": ["shown","unchecked","label"],
      "additionalProperties": false,
      "properties": {
        "shown": {"type": "boolean"},
        "unchecked": {"type": "array", "items": {"type": "string"}},
        "label": {"type": "string"}
      }
    }
  }
}
