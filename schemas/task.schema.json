{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/v2/task.schema.json",
  "title": "Task (how-to) record",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "short_title",
    "family_id",
    "problem_statement",
    "expected_outcome",
    "difficulty",
    "steps",
    "recommended_tool_ids",
    "quality_checks",
    "category_ids"
  ],
  "properties": {
    "schema_version": {},
    "is_illustrative": {},
    "redirect_from": {},
    "sources": {},
    "editorial": {},
    "disclosure": {},
    "id": {
      "type": "string",
      "pattern": "^task_[a-z0-9_]+$",
      "maxLength": 64
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90,
      "description": "Phrased as the user's question, e.g. 'How do I edit a video for free?'"
    },
    "short_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48
    },
    "family_id": {
      "$ref": "common.schema.json#/$defs/task_family_slug"
    },
    "problem_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 8
    },
    "difficulty": {
      "$ref": "common.schema.json#/$defs/skill_level"
    },
    "estimated_time": {
      "$ref": "common.schema.json#/$defs/estimate"
    },
    "budget_note": {
      "type": "string",
      "maxLength": 300
    },
    "device_note": {
      "type": "string",
      "maxLength": 300
    },
    "low_bandwidth_note": {
      "type": "string",
      "maxLength": 300
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "title",
          "instructions",
          "expected_result"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "instructions": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1200
          },
          "tool_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tool_[a-z0-9_]+$",
              "maxLength": 64
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "expected_result": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "warning": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "minItems": 2,
      "uniqueItems": false,
      "maxItems": 15
    },
    "recommended_tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tool_[a-z0-9_]+$",
        "maxLength": 64
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 6
    },
    "alternative_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 5
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 8
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 8
    },
    "privacy_or_safety_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 5
    },
    "related_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[a-z0-9_]+$",
        "maxLength": 64
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^res_[a-z0-9_]+$",
        "maxLength": 64
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "playbook_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pb_[a-z0-9_]+$",
        "maxLength": 64
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "category_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/category_slug"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 3
    },
    "audience_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/audience_slug"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "search_aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 15
    }
  }
}