{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/v2/registry-entry.schema.json",
  "title": "Tool registry entry \u2014 one item of 08_Starter_Catalogue/registry/tools-registry.json values[]",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "publisher",
    "official_url",
    "url_status",
    "category_id",
    "profile_status",
    "pricing_model",
    "note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9_]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "official_url": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "url_status": {
      "enum": [
        "to_confirm",
        "ok",
        "redirected",
        "broken"
      ]
    },
    "category_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "profile_status": {
      "enum": [
        "stub",
        "profiled"
      ]
    },
    "pricing_model": {
      "const": "unknown",
      "description": "Registry entries never carry pricing; full tool profiles (tool.schema.json) do."
    },
    "note": {
      "type": "string"
    }
  }
}