{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/v2/goal.schema.json",
  "title": "Goal — one item of taxonomy/goals.json values[] (D-071)",
  "description": "A finer, outcome-phrased job a person wants done. Hangs under one parent need so identities still reach it. Its tools are interchangeable ways to do the same job; alternatives for a tool are derived from these lists (D-072).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "label", "need", "intents", "markets", "search_terms", "tool_ids", "expert_validation"],
  "properties": {
    "id": { "type": "string", "pattern": "^goal_[a-z0-9_]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "label": { "type": "string", "minLength": 8, "maxLength": 90 },
    "need": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "Slug of the parent need." },
    "intents": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["compete", "grow", "scale"] }, "description": "Inherited from the parent need (needs_intents.txt)." },
    "markets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["all", "ng", "africa"] } },
    "search_terms": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
    "tool_ids": { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^tool_[a-z0-9_]+$" } },
    "expert_validation": {
      "type": "object", "required": ["status", "note"], "additionalProperties": false,
      "properties": { "status": { "enum": ["pending", "in_review", "validated"] }, "note": { "type": "string", "maxLength": 300 } }
    }
  }
}
