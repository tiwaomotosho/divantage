{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/v2/identity.schema.json",
  "title": "Identity (profession, specialism or life role) \u2014 one item of taxonomy/identities/identities.json values[]",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "label",
    "aliases",
    "kind",
    "sector",
    "family",
    "parent",
    "isco08_submajor",
    "needs",
    "expert_validation",
    "isco08_units"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^id_[a-z0-9_]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "kind": {
      "enum": [
        "profession",
        "specialism",
        "life_role"
      ]
    },
    "sector": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "isco08_submajor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "expert_validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in_review",
            "validated"
          ]
        },
        "note": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        },
        "validated_at": {
          "type": "string",
          "format": "date"
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "retired": {
      "type": "boolean"
    },
    "replaced_by": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "isco08_units": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      },
      "uniqueItems": true,
      "description": "ISCO-08 unit groups (4-digit) this identity belongs to; see taxonomy/identities/isco08-unit-groups.json"
    }
  }
}