{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaladvantage.example/schemas/helper.schema.json",
  "title": "Helper (guided path)",
  "description": "A helper follows a person across the app and shows their stage and next step (D-066, FR-068). Built from taxonomy/source/helpers.txt by build_helpers.py.",
  "type": "object",
  "required": ["slug", "title", "identities", "promise", "intro", "stages"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "title": { "type": "string", "minLength": 5, "maxLength": 60 },
    "identities": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "uniqueItems": true },
    "promise": { "type": "string", "minLength": 10, "maxLength": 120 },
    "intro": { "type": "string", "minLength": 40, "maxLength": 600 },
    "stages": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["n", "title", "goal", "time", "steps", "done"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 3, "maxLength": 60 },
          "goal": { "type": "string", "minLength": 10, "maxLength": 140 },
          "time": { "type": "string", "minLength": 3, "maxLength": 30 },
          "steps": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["tool", "what"],
              "properties": {
                "tool": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "need": { "type": ["string", "null"] },
                "what": { "type": "string", "minLength": 10, "maxLength": 220 },
                "first_win": { "type": "string", "maxLength": 140 }
              }
            }
          },
          "done": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 5, "maxLength": 120 } }
        }
      }
    }
  }
}
