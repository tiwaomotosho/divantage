      },
      {
        "id": "free_trial",
        "label": "Free trial",
        "description": "Access is time-limited or trial-based; payment is needed afterwards.",
        "starts_without_paying": false
      },
      {
        "id": "paid_subscription",
        "label": "Subscription",
        "description": "Ongoing payment is required for the described use.",
        "starts_without_paying": false
      },
      {
        "id": "paid_once",
        "label": "One-time purchase",
        "description": "A single purchase for the described product or edition.",
        "starts_without_paying": false
      },
      {
        "id": "open_source",
        "label": "Open source",
        "description": "Source code is available under a stated licence. This does not automatically mean hosting or use costs nothing.",
        "starts_without_paying": true
      },
      {
        "id": "usage_based",
        "label": "Pay as you go",
        "description": "Cost depends on usage.",
        "starts_without_paying": false
      },
      {
        "id": "enterprise_quote",
        "label": "Quote on request",
        "description": "Pricing requires a sales quote.",
        "starts_without_paying": false
      },
      {
        "id": "mixed",
        "label": "Several pricing options",
        "description": "Different editions or features use materially different models; see details.",
        "starts_without_paying": null
      },
      {
        "id": "unknown",
        "label": "Price not confirmed",
        "description": "Not verified. Never displayed as free.",
        "starts_without_paying": null
      }
    ],
    "rules": [
      "'Free' must never stand in for freemium or a trial.",
      "starts_without_paying=null means the record's free_tier_details decides; for 'mixed' it is true only if a free edition is verified.",
      "A pricing_model other than 'unknown' requires pricing.source_ids with at least one source of type official_pricing or official_site checked within the review interval."
    ]
  },
