# V2.8 (D-083): Vercel project environment variables (Production, Preview, Development). Local: copy to .env.local. Never commit real values.
# Cron: /api/cron/daily runs at 02:00 UTC (03:00 Africa/Lagos) and calls refresh_trending(current_date - 6) then purge_old_rows() (db/0002).
SITE_URL=https://digitaladvantage.example         # D-019: replace when domain chosen
CONTENT_INCLUDE_IN_REVIEW=false                   # true on preview builds only: shows in_review records with a "Preview, not yet published" banner
# --- database (Neon via the Vercel Marketplace) ---
DATABASE_URL=                                     # secret, pooled connection string (Neon)
DATABASE_URL_UNPOOLED=                            # secret, for migrations only
# --- auth (D-077; stack chosen by Spike S-2) ---
AUTH_SECRET=                                      # secret, 32+ random bytes
AUTH_GOOGLE_ID=                                   # public client id
AUTH_GOOGLE_SECRET=                               # secret
EMAIL_FROM=Digital Advantage <login@digitaladvantage.example>
EMAIL_API_KEY=                                    # secret, transactional email provider (one-time codes)
# --- forms and corrections ---
TURNSTILE_SITE_KEY=                               # public, used by the form widget
TURNSTILE_SECRET_KEY=                             # secret, server only
CORRECTIONS_GITHUB_REPO=owner/da-corrections      # private repo
CORRECTIONS_GITHUB_TOKEN=                         # secret, fine-grained PAT: Issues read/write on da-corrections ONLY
# --- abuse control ---
RATE_LIMIT_SALT=                                  # secret, random 32+ bytes, rotated monthly
RATE_LIMIT_STORE=postgres                         # hashed-IP counters live in Postgres table rate_limits (or Vercel KV); IPs are never stored raw
CRON_SECRET=                                      # secret, Vercel sends it as a Bearer token to /api/cron/*
